# Search Strategy Configuration
# USE_SGPBUSINESS: Controls how to find company websites
#   "true"   = Use SGPBusiness.com only (FREE, Singapore companies only)
#   "hybrid" = Try SGPBusiness.com first, fallback to API if needed (DEFAULT, RECOMMENDED)
#   "false"  = Use only SerpAPI/Bing (costs API quota)
USE_SGPBUSINESS=hybrid

# Search API Keys (Optional if USE_SGPBUSINESS=true)
SERPAPI_KEY=your_serpapi_key_here
BING_SEARCH_KEY=your_bing_search_key_here

# Application Configuration
FRONTEND_URL=https://your-frontend-url.onrender.com
SECRET_KEY=your_secret_key_here
ENVIRONMENT=production
