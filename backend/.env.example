# ===========================================
# SEARCH API CONFIGURATION
# ===========================================

# SerpAPI Key (REQUIRED for Google Maps search)
# Sign up at https://serpapi.com/ - Free tier: 100 searches/month
# Used for: Google Maps business search (primary method)
#          Web search fallback (secondary method)
SERPAPI_KEY=your_serpapi_key_here

# Bing Search API Key (OPTIONAL - fallback for web search)
# Azure Cognitive Services - Bing Search v7
BING_SEARCH_KEY=your_bing_search_key_here

# ===========================================
# CLOUDFLARE BYPASS (OPTIONAL)
# ===========================================

# FlareSolverr Configuration (for blocked websites)
# IMPORTANT: Must include /v1 endpoint path
# Only needed if company websites have Cloudflare protection
FLARESOLVERR_URL=https://your-flaresolverr.onrender.com/v1

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

FRONTEND_URL=https://your-frontend-url.onrender.com
SECRET_KEY=your_secret_key_here
ENVIRONMENT=production

# ===========================================
# LEGACY/UNUSED (can be removed)
# ===========================================
# USE_SGPBUSINESS is no longer used - Google Maps is now the primary search method
